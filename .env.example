# Salin berkas ini menjadi .env.local lalu isi dengan nilai proyek Supabase Anda.
# .env.local TIDAK boleh di-commit (sudah diabaikan lewat .gitignore).
# Nilai-nilai di bawah bisa dilihat di: Supabase Dashboard -> Project Settings -> API

# URL proyek, contoh: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Kunci "anon public". Ikut terkirim ke browser, jadi memang bersifat publik.
# Keamanan data bergantung pada Row-Level Security, bukan pada kerahasiaan kunci ini.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kunci "service_role". RAHASIA. Menembus seluruh Row-Level Security.
# Hanya dipakai di sisi server (API route dan skrip import-csv.js).
SUPABASE_SERVICE_ROLE_KEY=

# Opsional. Nama instruktur pada berkas Excel klaim, dipakai bila akun Supabase
# belum punya metadata "full_name".
INSTRUCTOR_NAME=

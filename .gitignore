/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files
# JANGAN PERNAH meng-commit .env.local: berisi SUPABASE_SERVICE_ROLE_KEY yang
# bisa menembus seluruh Row-Level Security database.
.env
.env.*
# Kecuali berkas contoh tanpa nilai rahasia, yang justru berguna dibagikan.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Windows & OneDrive
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Data pribadi
# Berkas klaim hasil unduhan dan rekap CSV berisi data honor serta nama peserta.
# Jangan sampai ikut terunggah ke GitHub.
*.xlsx
*.xls
migrasi_*.csv
